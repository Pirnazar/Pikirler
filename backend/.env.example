# Copy to .env and replace every "change_me" value. Never commit .env.

# --- Infrastructure (docker compose) ---------------------------------------
POSTGRES_DB=pikirler
POSTGRES_USER=pikirler
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5460
REDIS_PORT=6460
API_PORT=8460
# RustFS (S3-compatible object storage) root credentials and S3 API port.
RUSTFS_PORT=9460
RUSTFS_ACCESS_KEY=pikirler
RUSTFS_SECRET_KEY=change_me_rustfs_at_least_8
# RUSTFS_IMAGE=rustfs/rustfs:1.0.4

# --- Application -------------------------------------------------------------
# development | production. Production enforces Secure cookies and a real key.
PIKIRLER_ENVIRONMENT=development
# 64+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
PIKIRLER_SECRET_KEY=change_me_secret_key_change_me_secret_key_change_me
# Outside docker compose set the URLs directly:
# PIKIRLER_DATABASE_URL=postgresql+asyncpg://pikirler:...@localhost:5460/pikirler
# PIKIRLER_REDIS_URL=redis://localhost:6460/0
PIKIRLER_CORS_ORIGINS=http://localhost:5173
PIKIRLER_COOKIE_SECURE=false
PIKIRLER_DEFAULT_TIMEZONE=Asia/Ashgabat

# --- Object storage ----------------------------------------------------------
# s3: the bundled RustFS (default) or any other S3-compatible storage — then
# point the endpoint and keys at it. local: files live in the "mediadata"
# docker volume (/srv/data/media); single-host setups only.
PIKIRLER_STORAGE_BACKEND=s3
PIKIRLER_S3_ENDPOINT_URL=http://rustfs:9000
PIKIRLER_S3_BUCKET=pikirler-private
# The API uses the RustFS root credentials: keep these equal to RUSTFS_*.
PIKIRLER_S3_ACCESS_KEY=pikirler
PIKIRLER_S3_SECRET_KEY=change_me_rustfs_at_least_8
PIKIRLER_S3_REGION=us-east-1
PIKIRLER_LOCAL_STORAGE_PATH=/srv/data/media
# Browser-reachable endpoint for presigned URLs. Empty = media is streamed
# through the API (owner session required), which works everywhere.
PIKIRLER_S3_PUBLIC_ENDPOINT_URL=

# --- Embeddings (semantic search). disabled | gemini | openai_compatible -----
PIKIRLER_EMBEDDING_PROVIDER=disabled
PIKIRLER_EMBEDDING_MODEL=
PIKIRLER_EMBEDDING_DIMENSIONS=768
# openai_compatible: e.g. a local text-embeddings-inference / Ollama server
# running EmbeddingGemma. Mark it local so no external-AI consent is needed.
PIKIRLER_EMBEDDING_BASE_URL=
PIKIRLER_EMBEDDING_API_KEY=
PIKIRLER_EMBEDDING_IS_LOCAL=false

# --- LLM (Ask My Thoughts). disabled | gemini | openai_compatible -----------
PIKIRLER_LLM_PROVIDER=disabled
PIKIRLER_LLM_MODEL=
PIKIRLER_LLM_BASE_URL=
PIKIRLER_LLM_API_KEY=
PIKIRLER_LLM_IS_LOCAL=false
PIKIRLER_GEMINI_API_KEY=
PIKIRLER_AI_DAILY_REQUEST_LIMIT=200

# --- Speech recognition. disabled | remote_whisper | openai_compatible | local_faster_whisper
PIKIRLER_ASR_PROVIDER=disabled
# remote_whisper: the asr_server/ app on the GPU machine.
PIKIRLER_ASR_BASE_URL=
PIKIRLER_ASR_API_KEY=
PIKIRLER_ASR_MODEL=
PIKIRLER_ASR_IS_LOCAL=true
